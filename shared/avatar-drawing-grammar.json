    "top",
    "back",
    "front",
    "left",
    "right",
    "ground",
    "orbit",
    "free"
  ],
  "rules": {
    "maxLayers": 42,
    "coordinateRange": [
      -280,
      280
    ],
    "scaleRange": [
      0.05,
      3.2
    ],
    "rotationRange": [
      -180,
      180
    ],
    "required": [
      "face",
      "mouth"
    ],
    "mouthLayerAnimated": true,
    "houseStyleProcess": [
      "Build one connected mascot silhouette first: shadow, body, overlapping head, attached limbs, face, then details.",
      "Every detail must be anchored to the surface it belongs to: spots/patches to bodyFront or face, ears/horns to the head, hooves to limbs/feet.",
      "Never make core limbs/hooves/ears/spots read as floating stickers; attach, overlap, or embed them into the parent surface.",
      "Use My Dude plush/toy proportions: rounded compact body, oversized friendly face, stubby limbs, glossy highlights.",
      "For animal avatars, use mascotBody + mascotHead + stubbyArm/stubbyLeg + hoof/cuteEye/bodyPatch before decorative horns/ears/details.",
      "For abstract shapes/forms/ideas/colors, still construct them as a mascot: readable core silhouette, face attached to core, details integrated into surfaces."
    ],
    "attachmentMath": {
      "enabled": true,
      "field": "attach.socket",
      "description": "Client can place parts on proportional mascot rig sockets instead of absolute coordinates.",
      "sockets": [
        "body.center",
        "body.front",
        "body.leftShoulder",
        "body.rightShoulder",
        "body.leftHand",
        "body.rightHand",
        "body.leftHip",
        "body.rightHip",
        "body.leftFoot",
        "body.rightFoot",
        "body.patchLeft",
        "body.patchRight",
        "head.center",
        "head.leftEar",
        "head.rightEar",
        "head.leftHorn",
        "head.rightHorn",
        "head.leftEye",
        "head.rightEye",
        "head.mouth",
        "head.patchLeft"
      ],
      "rule": "Prefer attach.socket for mascot pieces; use x/y only as small local offsets from the socket."
    }
  }
}
