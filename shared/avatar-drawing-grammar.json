  "anchors": [
    "body",
    "bodyFront",
    "bodyBack",
    "bodyTop",
    "bodyBottom",
    "head",
    "face",
    "forehead",
    "leftEye",
    "rightEye",
    "eyes",
    "mouth",
    "leftCheek",
