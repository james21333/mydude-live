{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mydude-live",
  "main": "src/index.js",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mydude.live/*",
      "zone_name": "mydude.live"
    },
    {
      "pattern": "www.mydude.live/*",
      "zone_name": "mydude.live"
    },
    {
      "pattern": "demo.mydude.live/*",
      "zone_name": "mydude.live"
    },
    {
      "pattern": "demo2.mydude.live/*",
      "zone_name": "mydude.live"
    },
    {
      "pattern": "clawtest.mydude.live/*",
      "zone_name": "mydude.live"
    },
    {
      "pattern": "testproject.mydude.live/*",
      "zone_name": "mydude.live"
    }
  ],
  "observability": {
    "enabled": true
  }
}
